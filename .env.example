# Local-only credentials match compose.yaml. Use distinct private credentials in production.
DATABASE_URL=postgres://tools_hub:local-development-only@127.0.0.1:55432/tools_hub
TEST_DATABASE_URL=postgres://tools_hub_test:local-test-only@127.0.0.1:55432/tools_hub_test

# Must exactly identify the public origin in production (HTTPS, no path).
# Development uses this origin too; update it if the development port changes.
APP_ORIGIN=http://127.0.0.1:3100

# Optional original deployment URLs, embedded at build time. Development defaults
# to http://localhost:4101 through 4104. Set only after verifying the deployments.
# NEXT_PUBLIC_ORIGINAL_DICTIONARY_URL=https://original-dictionary.skylerrsimpson.com
# NEXT_PUBLIC_ORIGINAL_DEVFINDER_URL=https://original-devfinder.skylerrsimpson.com
# NEXT_PUBLIC_ORIGINAL_TODO_URL=https://original-todo.skylerrsimpson.com
# NEXT_PUBLIC_ORIGINAL_TIP_URL=https://original-tip.skylerrsimpson.com
